{
  "name": "pi-extends",
  "version": "0.1.0",
  "description": "Pi TUI extension package: cockpit console, theme/model/role management, subagents, goal mode, and plan mode.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "tui",
    "extension",
    "subagent",
    "plan-mode"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\"",
    "pack:dry": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.7.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "files": [
    "extensions",
    "prompts",
    "themes",
    "templates",
    "schemas",
    "LICENSE",
    "README.md",
    "PLAN.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
