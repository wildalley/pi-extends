{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pi Extends Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "theme": { "type": "string" },
    "currentModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "thinking"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$" },
        "thinking": { "$ref": "#/$defs/thinkingLevel" }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scout": { "$ref": "#/$defs/role" },
        "planner": { "$ref": "#/$defs/role" },
        "worker": { "$ref": "#/$defs/role" },
        "reviewer": { "$ref": "#/$defs/role" }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "$ref": "#/$defs/route" },
        "smol": { "$ref": "#/$defs/route" },
        "slow": { "$ref": "#/$defs/route" },
        "plan": { "$ref": "#/$defs/route" },
        "commit": { "$ref": "#/$defs/route" },
        "vision": { "$ref": "#/$defs/route" },
        "designer": { "$ref": "#/$defs/route" },
        "task": { "$ref": "#/$defs/route" },
        "advisor": { "$ref": "#/$defs/route" },
        "tiny": { "$ref": "#/$defs/route" }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minSeverity": { "enum": ["aside", "concern", "blocker"] },
        "maxPerSession": { "type": "integer", "minimum": 1 }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/customProvider" }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallelTasks": { "type": "integer", "minimum": 1 },
        "maxConcurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMode": { "enum": ["focused", "autopilot"] },
        "maxAutoTurns": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "required": ["version", "theme", "currentModel", "roles", "providers", "subagents", "goal"],
  "$defs": {
    "thinkingLevel": {
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$" },
        "thinking": { "$ref": "#/$defs/thinkingLevel" },
        "tools": {
          "type": "array",
          "items": { "enum": ["read", "grep", "find", "ls", "bash", "edit", "write"] }
        },
        "systemPrompt": { "type": "string" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$" },
        "thinking": { "$ref": "#/$defs/thinkingLevel" },
        "fallback": {
          "type": "array",
          "items": {
            "enum": [
              "default",
              "smol",
              "slow",
              "plan",
              "commit",
              "vision",
              "designer",
              "task",
              "advisor",
              "tiny"
            ]
          }
        }
      }
    },
    "customProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "baseUrl", "api", "apiKeyEnv", "models"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$", "maxLength": 64 },
        "name": { "type": "string" },
        "baseUrl": { "type": "string", "format": "uri" },
        "api": { "enum": ["openai-completions", "openai-responses", "anthropic-messages"] },
        "apiKeyEnv": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "reasoning": { "type": "boolean" },
              "input": { "type": "array", "items": { "enum": ["text", "image"] } },
              "contextWindow": { "type": "integer", "minimum": 1 },
              "maxTokens": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
