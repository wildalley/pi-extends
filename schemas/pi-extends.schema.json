{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pi Extends Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "theme": {
      "type": "string"
    },
    "icons": {
      "description": "界面图标字形集。lucide 需要把 lucide.ttf 加进终端 fallback 字体；nerd 需要 Nerd Font 补丁字体；unicode 任何字体都能显示；ascii 给纯文本终端。",
      "enum": [
        "lucide",
        "nerd",
        "unicode",
        "ascii"
      ]
    },
    "border": {
      "description": "卡片边框样式。round 圆角外框、square 方角外框、none 不画框（退回纯缩进排版）。",
      "enum": [
        "round",
        "square",
        "none"
      ]
    },
    "currentModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "thinking"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$"
        },
        "thinking": {
          "$ref": "#/$defs/thinkingLevel"
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scout": {
          "$ref": "#/$defs/role"
        },
        "planner": {
          "$ref": "#/$defs/role"
        },
        "worker": {
          "$ref": "#/$defs/role"
        },
        "reviewer": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/route"
        },
        "smol": {
          "$ref": "#/$defs/route"
        },
        "slow": {
          "$ref": "#/$defs/route"
        },
        "plan": {
          "$ref": "#/$defs/route"
        },
        "commit": {
          "$ref": "#/$defs/route"
        },
        "vision": {
          "$ref": "#/$defs/route"
        },
        "designer": {
          "$ref": "#/$defs/route"
        },
        "task": {
          "$ref": "#/$defs/route"
        },
        "advisor": {
          "$ref": "#/$defs/route"
        },
        "tiny": {
          "$ref": "#/$defs/route"
        }
      }
    },
    "advisor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minSeverity": {
          "enum": [
            "aside",
            "concern",
            "blocker"
          ]
        },
        "maxPerSession": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "description": "自动分工：识别适合拆分的任务并给出建议或直接编排。",
      "properties": {
        "mode": {
          "enum": [
            "off",
            "suggest",
            "auto"
          ],
          "description": "off 不提示；suggest 给建议卡片、确认后注入；auto 直接注入编排指令。"
        },
        "minComplexity": {
          "type": "integer",
          "minimum": 1,
          "description": "复杂度评分达到该阈值才提示，避免小任务被打断。"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "description": "桌面通知：Linux 走 notify-send，macOS 走 osascript。默认关闭（SSH/容器里没有通知守护进程）。",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "总开关。关闭时下面所有开关都不生效。"
        },
        "minSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "回合至少跑这么久才通知，避免快问快答也弹窗。0 表示每轮都通知。"
        },
        "onIdle": {
          "type": "boolean",
          "description": "回合结束（模型停下等输入）时通知。"
        },
        "onAdvisorBlocker": {
          "type": "boolean",
          "description": "Advisor 报出 blocker 级意见时通知，不受 minSeconds 限制。"
        },
        "onSubagent": {
          "type": "boolean",
          "description": "每个子代理结束时都通知。派得多的时候会很吵，默认关闭。"
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customProvider"
      }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxParallelTasks": {
          "type": "integer",
          "minimum": 1
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultMode": {
          "enum": [
            "focused",
            "autopilot"
          ]
        },
        "maxAutoTurns": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "version",
    "theme",
    "currentModel",
    "roles",
    "providers",
    "subagents",
    "goal"
  ],
  "$defs": {
    "thinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$"
        },
        "thinking": {
          "$ref": "#/$defs/thinkingLevel"
        },
        "tools": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "grep",
              "find",
              "ls",
              "bash",
              "edit",
              "write"
            ]
          }
        },
        "systemPrompt": {
          "type": "string"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$"
        },
        "thinking": {
          "$ref": "#/$defs/thinkingLevel"
        },
        "fallback": {
          "type": "array",
          "items": {
            "enum": [
              "default",
              "smol",
              "slow",
              "plan",
              "commit",
              "vision",
              "designer",
              "task",
              "advisor",
              "tiny"
            ]
          }
        }
      }
    },
    "customProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "baseUrl",
        "api",
        "apiKeyEnv",
        "models"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "maxLength": 64
        },
        "name": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "api": {
          "enum": [
            "openai-completions",
            "openai-responses",
            "anthropic-messages"
          ]
        },
        "apiKeyEnv": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "description": "第三方中转的缓存能力声明。缺省/auto 不把归一化后的 0 当成确切零命中。",
          "properties": {
            "metrics": {
              "enum": [
                "auto",
                "reported",
                "unreported"
              ],
              "description": "reported 表示中转可靠上报 cacheRead/cacheWrite；unreported 表示不可靠；auto 保守判断。"
            },
            "anthropicCacheControl": {
              "type": "boolean",
              "description": "OpenAI Completions 兼容端点是否接受 Anthropic 风格 cache_control 标记。"
            },
            "supportsLongRetention": {
              "type": "boolean",
              "description": "中转是否支持长缓存保留；仍需 PI_CACHE_RETENTION=long 才会请求。"
            }
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "reasoning": {
                "type": "boolean"
              },
              "input": {
                "type": "array",
                "items": {
                  "enum": [
                    "text",
                    "image"
                  ]
                }
              },
              "contextWindow": {
                "type": "integer",
                "minimum": 1
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              },
              "cost": {
                "type": "object",
                "additionalProperties": false,
                "description": "每百万 token 的美元价格；缺省表示价格未知，不等同于免费。",
                "required": [
                  "input",
                  "output",
                  "cacheRead",
                  "cacheWrite"
                ],
                "properties": {
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheRead": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cacheWrite": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
